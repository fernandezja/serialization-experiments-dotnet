<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	  <!--
  PROOF OF CONCEPT ONLY — NOT RECOMMENDED FOR PRODUCTION.

  This setting only enables BinaryFormatter on runtimes that still support it.
  BinaryFormatter is removed in .NET 9 and later; this project targets .NET 10,
  where serialization and deserialization throw PlatformNotSupportedException.
  BinaryFormatter is obsolete and vulnerable. Never deserialize untrusted data.

  Anyone who copies or enables this setting in another application does so at
  their own risk and is solely responsible for assessing its security impact.
  Remove this setting and migrate to a supported serialization format before
  using this code in production.
-->
	  <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginDesign\PluginDesign.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeserializeObjectFromStringThatIsAnByteArray.Tests" />
  </ItemGroup>

</Project>
